diff --git a/source/m3_core.c b/source/m3_core.c
index 5980ab8..a2834c6 100644
--- a/source/m3_core.c
+++ b/source/m3_core.c
@@ -19,10 +19,17 @@ void m3_Abort(const char* message) {
     abort();
 }
 
+static M3Result (* s_yieldHook) (void) = NULL;
+
+void m3_SetYieldHook (M3Result (* i_hook) (void))
+{
+    s_yieldHook = i_hook;
+}
+
 M3_WEAK
 M3Result m3_Yield ()
 {
-    return m3Err_none;
+    return s_yieldHook ? s_yieldHook () : m3Err_none;
 }
 
 #if d_m3LogTimestamps
diff --git a/source/m3_exec.h b/source/m3_exec.h
index 7fa7f46..9b05492 100644
--- a/source/m3_exec.h
+++ b/source/m3_exec.h
@@ -888,6 +888,13 @@ d_m3Op  (Loop)
         // linear memory pointer needs refreshed here because the block it's looping over
         // can potentially invoke the grow operation.
         _mem = memory->mallocated;
+
+        // Each iteration yields too, so a loop that calls nothing can still be stopped.
+        if (r == _pc)
+        {
+            m3ret_t possible_trap = m3_Yield ();
+            if (M3_UNLIKELY(possible_trap)) return possible_trap;
+        }
     }
     while (r == _pc);
 
