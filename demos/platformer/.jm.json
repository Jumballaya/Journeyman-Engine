{
  "name": "Super Pip",
  "version": "0.1.0",
  "engine": "../../build/release/engine/journeyman_engine",
  "entryScene": "scenes/title.scene.json",
  "scenes": [
    "scenes/title.scene.json",
    "scenes/intro.scene.json",
    "scenes/level_1-1.scene.json",
    "scenes/level_1-2.scene.json",
    "scenes/level_1-3.scene.json",
    "scenes/game_over.scene.json",
    "scenes/victory.scene.json",
    "scenes/test_1-2.scene.json",
    "scenes/test_1-3.scene.json",
    "scenes/test_flag.scene.json",
    "scenes/test_king.scene.json",
    "scenes/test_mushroom.scene.json"
  ],
  "assets": [
    "assets/scripts/*.ts",
    "assets/prefabs/*.prefab.json",
    "assets/atlases/sprites.atlas.json",
    "assets/input.bindings.json",
    "assets/sounds/*.wav",
    "assets/ui/theme.css",
    "assets/ui/*.ui.html",
    "assets/maps/*.tsj",
    "assets/maps/*.tmj"
  ],
  "config": {
    "window": {
      "width": 768,
      "height": 672,
      "resizable": true,
      "vsync": true,
      "hideCursor": true
    },
    "renderer": {
      "logicalWidth": 256,
      "logicalHeight": 224,
      "clearColor": [
        0.42,
        0.62,
        0.98,
        1
      ],
      "letterboxColor": [
        0,
        0,
        0,
        1
      ]
    }
  }
}
